<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.11.0" />
    <PackageReference Include="Microsoft.Graph" Version="5.12.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.17.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
  </ItemGroup>

  <!-- React Consent UI: build and embed as static files -->
  <PropertyGroup>
    <ReactAppDir>$(MSBuildProjectDirectory)\..\auth-context-frontend-app</ReactAppDir>
    <ReactOutputDir>$(MSBuildProjectDirectory)\wwwroot\context</ReactOutputDir>
  </PropertyGroup>

  <!-- Auto-build React on publish (production deploy) -->
  <Target Name="BuildReactApp" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' OR '$(BuildReact)' == 'true'">
    <Message Text="Building React consent UI..." Importance="high" />
    <Exec Command="npm install --prefer-offline" WorkingDirectory="$(ReactAppDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(ReactAppDir)" />
    <RemoveDir Directories="$(ReactOutputDir)" />
    <ItemGroup>
      <ReactBuildFiles Include="$(ReactAppDir)\build\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReactBuildFiles)" DestinationFolder="$(ReactOutputDir)\%(RecursiveDir)" />
    <Message Text="React consent UI built and copied to wwwroot/context/" Importance="high" />
  </Target>

</Project>
